package com.example.ridafx;

import javafx.animation.*;
import javafx.application.Application;
import javafx.geometry.Insets;
import javafx.geometry.Pos;
import javafx.scene.Scene;
import javafx.scene.control.Button;
import javafx.scene.control.Label;
import javafx.scene.layout.*;
import javafx.scene.paint.Color;
import javafx.scene.shape.*;
import javafx.scene.text.Font;
import javafx.scene.text.FontWeight;
import javafx.stage.Stage;
import javafx.util.Duration;

import java.util.HashMap;
import java.util.Map;
import java.util.Random;

/**
 * com.example.ridafx.SnakesAndLadders JavaFX Application
 * Features:
 * 1. 10x10 Boustrophedon board layout (1-100).
 * 2. Ladders (7->17, 34->54, 19->62, 60->64, 24->87, 73->93, 79->98, 80->100).
 * 3. Snakes (38->1, 14->4, 31->9, 42->21, 84->28, 67->51, 91->71).
 * 4. Step-by-step pawn transitions and sliding animations.
 * 5. Exact land rule for square 100.
 * 6. Visual offset when players share the exact same tile.
 */
public class SnakesAndLadders extends Application {

    private static final int BOARD_SIZE = 10;
    private static final double TILE_SIZE = 60.0;

    // Ladder mapping: Bottom -> Top
    private final Map<Integer, Integer> ladders = new HashMap<>() {{
        put(7, 17);
        put(34, 54);
        put(19, 62);
        put(60, 64);
        put(24, 87);
        put(73, 93);
        put(79, 98);
        put(80, 100);
    }};

    // Snake mapping: Head -> Tail
    private final Map<Integer, Integer> snakes = new HashMap<>() {{
        put(38, 1);
        put(14, 4);
        put(31, 9);
        put(42, 21);
        put(84, 28);
        put(67, 51);
        put(91, 71);
    }};

    private final int[] playerPositions = {1, 1}; // Player 1 (0), Player 2 (1)
    private int currentPlayer = 0; // 0 = Player 1, 1 = Player 2
    private boolean isAnimating = false;

    private Circle player1Pawn;
    private Circle player2Pawn;
    private Label statusLabel;
    private Label diceLabel;
    private Button rollButton;

    private final Random random = new Random();

    @Override
    public void start(Stage primaryStage) {
        primaryStage.setTitle("com.example.ridafx.SnakesAndLadders");

        BorderPane root = new BorderPane();
        root.setPadding(new Insets(15));
        root.setStyle("-fx-background-color: #1e293b;");

        // Top Control / Status Header
        VBox topBox = createHeader();
        root.setTop(topBox);

        // Center Board Container
        Pane boardPane = createBoardPane();
        root.setCenter(boardPane);

        // Initialize Pawns
        setupPawns(boardPane);

        Scene scene = new Scene(root, 680, 800);
        primaryStage.setScene(scene);
        primaryStage.setResizable(false);
        primaryStage.show();
    }

    private VBox createHeader() {
        VBox topBox = new VBox(10);
        topBox.setAlignment(Pos.CENTER);
        topBox.setPadding(new Insets(0, 0, 15, 0));

        Label titleLabel = new Label("Snakes & Ladders");
        titleLabel.setFont(Font.font("Arial", FontWeight.BOLD, 28));
        titleLabel.setTextFill(Color.web("#f59e0b"));

        statusLabel = new Label("Player 1's turn (Red)");
        statusLabel.setFont(Font.font("Arial", FontWeight.SEMI_BOLD, 16));
        statusLabel.setTextFill(Color.web("#e2e8f0"));

        HBox controlBox = new HBox(15);
        controlBox.setAlignment(Pos.CENTER);

        diceLabel = new Label("🎲 1");
        diceLabel.setFont(Font.font("Arial", FontWeight.BOLD, 22));
        diceLabel.setTextFill(Color.WHITE);

        rollButton = new Button("Roll Dice");
        rollButton.setFont(Font.font("Arial", FontWeight.BOLD, 14));
        rollButton.setStyle("-fx-background-color: #10b981; -fx-text-fill: white; -fx-background-radius: 8;");
        rollButton.setOnAction(e -> handleTurn());

        controlBox.getChildren().addAll(diceLabel, rollButton);
        topBox.getChildren().addAll(titleLabel, statusLabel, controlBox);
        return topBox;
    }

    private Pane createBoardPane() {
        Pane pane = new Pane();
        pane.setPrefSize(BOARD_SIZE * TILE_SIZE, BOARD_SIZE * TILE_SIZE);
        pane.setStyle("-fx-border-color: #475569; -fx-border-width: 4; -fx-border-radius: 4;");

        // Render 100 Squares
        for (int r = 0; r < BOARD_SIZE; r++) {
            int rowFromBottom = 9 - r;
            for (int c = 0; c < BOARD_SIZE; c++) {
                int squareNum;
                if (rowFromBottom % 2 == 0) {
                    squareNum = rowFromBottom * 10 + c + 1;
                } else {
                    squareNum = rowFromBottom * 10 + (9 - c) + 1;
                }

                Rectangle tile = new Rectangle(c * TILE_SIZE, r * TILE_SIZE, TILE_SIZE, TILE_SIZE);
                boolean isEven = (r + c) % 2 == 0;
                tile.setFill(isEven ? Color.web("#f0fdf4") : Color.web("#dcfce7"));
                tile.setStroke(Color.web("#cbd5e1"));

                Label numLabel = new Label(String.valueOf(squareNum));
                numLabel.setFont(Font.font("Arial", FontWeight.BOLD, 11));
                numLabel.setTextFill(Color.web("#1e293b"));
                numLabel.setLayoutX(c * TILE_SIZE + 4);
                numLabel.setLayoutY(r * TILE_SIZE + 2);

                pane.getChildren().addAll(tile, numLabel);
            }
        }

        // Render Ladders
        for (Map.Entry<Integer, Integer> ladder : ladders.entrySet()) {
            double[] start = getSquareCenter(ladder.getKey(), 0);
            double[] end = getSquareCenter(ladder.getValue(), 0);

            Line line = new Line(start[0], start[1], end[0], end[1]);
            line.setStroke(Color.web("#d97706"));
            line.setStrokeWidth(8);
            line.setStrokeLineCap(StrokeLineCap.ROUND);
            pane.getChildren().add(line);
        }

        // Render Snakes
        for (Map.Entry<Integer, Integer> snake : snakes.entrySet()) {
            double[] start = getSquareCenter(snake.getKey(), 0);
            double[] end = getSquareCenter(snake.getValue(), 0);

            Line line = new Line(start[0], start[1], end[0], end[1]);
            line.setStroke(Color.web("#dc2626"));
            line.setStrokeWidth(10);
            line.getStrokeDashArray().addAll(10.0, 10.0);
            line.setStrokeLineCap(StrokeLineCap.ROUND);
            pane.getChildren().add(line);
        }

        return pane;
    }

    private void setupPawns(Pane boardPane) {
        player1Pawn = new Circle(14, Color.web("#ef4444"));
        player1Pawn.setStroke(Color.WHITE);
        player1Pawn.setStrokeWidth(2);

        player2Pawn = new Circle(14, Color.web("#3b82f6"));
        player2Pawn.setStroke(Color.WHITE);
        player2Pawn.setStrokeWidth(2);

        boardPane.getChildren().addAll(player1Pawn, player2Pawn);
        updatePawnPositions(false);
    }

    private double[] getSquareCenter(int squareNum, int playerOffset) {
        int index = squareNum - 1;
        int rowFromBottom = index / 10;
        int colInRow = index % 10;

        int gridRow = 9 - rowFromBottom;
        int gridCol = (rowFromBottom % 2 == 0) ? colInRow : (9 - colInRow);

        double x = (gridCol + 0.5) * TILE_SIZE + (playerOffset * 12.0);
        double y = (gridRow + 0.5) * TILE_SIZE;

        return new double[]{x, y};
    }

    private void updatePawnPositions(boolean animate) {
        boolean sameSquare = playerPositions[0] == playerPositions[1];

        double[] p1Coords = getSquareCenter(playerPositions[0], sameSquare ? -1 : 0);
        double[] p2Coords = getSquareCenter(playerPositions[1], sameSquare ? 1 : 0);

        if (!animate) {
            player1Pawn.setCenterX(p1Coords[0]);
            player1Pawn.setCenterY(p1Coords[1]);
            player2Pawn.setCenterX(p2Coords[0]);
            player2Pawn.setCenterY(p2Coords[1]);
        }
    }

    private void handleTurn() {
        if (isAnimating) return;
        isAnimating = true;
        rollButton.setDisable(true);

        int diceRoll = random.nextInt(6) + 1;
        diceLabel.setText("🎲 " + diceRoll);

        int currentPos = playerPositions[currentPlayer];
        int targetPos = currentPos + diceRoll;

        // Exact Landing Rule: exceed 100 stay in current position
        if (targetPos > 100) {
            statusLabel.setText("Player " + (currentPlayer + 1) + " rolled " + diceRoll + "! Move exceeds 100. Stays at " + currentPos);
            Timeline pause = new Timeline(new KeyFrame(Duration.seconds(1.5), e -> switchTurn()));
            pause.play();
            return;
        }

        // Step-by-step path movement transition
        SequentialTransition stepSequence = new SequentialTransition();
        Circle activePawn = (currentPlayer == 0) ? player1Pawn : player2Pawn;

        for (int step = currentPos + 1; step <= targetPos; step++) {
            double[] coords = getSquareCenter(step, 0);
            TranslateTransition tt = new TranslateTransition(Duration.millis(250), activePawn);

            // Calculate relative offset for TranslateTransition
            double targetTranslateX = coords[0] - activePawn.getCenterX();
            double targetTranslateY = coords[1] - activePawn.getCenterY();

            tt.setToX(targetTranslateX);
            tt.setToY(targetTranslateY);
            stepSequence.getChildren().add(tt);
        }

        stepSequence.setOnFinished(e -> {
            // Update actual center position and reset translation
            double[] finalCoords = getSquareCenter(targetPos, 0);
            activePawn.setCenterX(finalCoords[0]);
            activePawn.setCenterY(finalCoords[1]);
            activePawn.setTranslateX(0);
            activePawn.setTranslateY(0);
            playerPositions[currentPlayer] = targetPos;

            // Check Ladder or Snake
            checkSpecialSquares(targetPos);
        });

        stepSequence.play();
    }

    private void checkSpecialSquares(int currentSquare) {
        Circle activePawn = (currentPlayer == 0) ? player1Pawn : player2Pawn;

        if (ladders.containsKey(currentSquare)) {
            int newPos = ladders.get(currentSquare);
            statusLabel.setText("🚀 Player " + (currentPlayer + 1) + " climbed a ladder to " + newPos + "!");
            slidePawn(activePawn, newPos);
        } else if (snakes.containsKey(currentSquare)) {
            int newPos = snakes.get(currentSquare);
            statusLabel.setText("🐍 Player " + (currentPlayer + 1) + " bitten by a snake! Sliding down to " + newPos + "...");
            slidePawn(activePawn, newPos);
        } else {
            finishTurnChecks();
        }
    }

    private void slidePawn(Circle pawn, int targetSquare) {
        double[] targetCoords = getSquareCenter(targetSquare, 0);

        TranslateTransition tt = new TranslateTransition(Duration.millis(600), pawn);
        tt.setToX(targetCoords[0] - pawn.getCenterX());
        tt.setToY(targetCoords[1] - pawn.getCenterY());

        tt.setOnFinished(e -> {
            pawn.setCenterX(targetCoords[0]);
            pawn.setCenterY(targetCoords[1]);
            pawn.setTranslateX(0);
            pawn.setTranslateY(0);
            playerPositions[currentPlayer] = targetSquare;
            finishTurnChecks();
        });

        tt.play();
    }

    private void finishTurnChecks() {
        if (playerPositions[currentPlayer] == 100) {
            statusLabel.setText("🎉 Player " + (currentPlayer + 1) + " WINS THE GAME! 🎉");
            rollButton.setDisable(true);
            return;
        }

        updatePawnPositions(false);
        switchTurn();
    }

    private void switchTurn() {
        currentPlayer = (currentPlayer == 0) ? 1 : 0;
        statusLabel.setText("Player " + (currentPlayer + 1) + "'s turn (" + (currentPlayer == 0 ? "Red" : "Blue") + ")");
        rollButton.setDisable(false);
        isAnimating = false;
    }

    public static void main(String[] args) {
        launch(args);
    }
}
